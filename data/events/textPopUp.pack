textPopUp.hx________PACKSEP________var textPopUp:FlxText = new FlxText();

function onEvent(_) {
	if (_.event.name == 'textPopUp'){
		textPopUp.text=_.event.params[0];
		if(textPopUp.text=="")remove(textPopUp);
		if(textPopUp.text=="")return;
		textPopUp.size=20;
		textPopUp.camera=camOther;
		textPopUp.screenCenter(FlxAxes.X);
		textPopUp.y=-textPopUp.height-5;
		textPopUp.font=Paths.font("futura.otf");
		textPopUp.color=_.event.params[1];
		textPopUp.size=30;
		add(textPopUp);
		trace("SHOULD_NOT_SEE_THIS_SHIT");
		FlxTween.tween(textPopUp, {y: (FlxG.height-textPopUp.height)/2}, 0.4, {ease: FlxEase.elasticOut});
	}
}________PACKSEP________{
	"params": [
		{
			"name": "Text",
			"type": "String",
			"defaultValue": null
		},{
			"name": "Color",
			"type": "ColorWheel",
			"defaultValue": "ffffff"
		}
	]
}